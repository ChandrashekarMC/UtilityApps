# Copy this to .env and fill values.
# Required for secure sessions.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Optional fallback local username/password login.
PERSONAL_SERVER_USER=mcc
PERSONAL_SERVER_PASSWORD=replace-with-strong-password

# Google OAuth credentials
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Optional comma-separated allow list
PERSONAL_GOOGLE_ALLOWED_EMAILS=

# Optional app links for dashboard
PERSONAL_FINANCE_URL=
PERSONAL_NOTES_URL=
